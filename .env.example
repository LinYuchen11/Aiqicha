# 复制本文件为 .env 后按需修改。.env 不会被提交到代码库。

# ===== 大模型（DeepSeek，OpenAI 兼容协议）=====
# 留空即自动进入 Mock 模式，不产生任何费用
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# auto = 有 Key 用真实模型、无 Key 自动降级 mock；deepseek = 强制真实；mock = 强制模拟
LLM_MODE=auto
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1500

# ===== Embedding =====
# 正式演示推荐档位：local（BAAI/bge-small-zh-v1.5，本地 BGE 语义向量，需可选依赖）
# 离线备用档位：hash（词面哈希向量，仅匹配字面重合，不是语义 Embedding，零下载）
# 开箱默认保持 hash，保证「只装默认依赖」也能跑通完整链路；
# 正式演示请执行 python scripts/switch_embedding.py local，脚本会自动重建向量库。
# 不同模型产生的向量禁止混用，系统会在检索前校验模型指纹。
EMBEDDING_MODE=hash
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 国内下载 HuggingFace 模型建议走镜像；留空则直连 huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# ===== 向量库 =====
# sqlite = 内置持久化向量表（默认）；chroma = Chroma（需可选依赖）
VECTOR_STORE=sqlite
CHROMA_PERSIST_DIR=./data/vector_db/chroma

# ===== RAG 参数 =====
CHUNK_SIZE=400
CHUNK_OVERLAP=80
DEFAULT_TOP_K=5
# 混合检索中向量分数权重（0~1），关键词权重为 1-HYBRID_WEIGHT
HYBRID_WEIGHT=0.6
# none = 不重排；rule = 内置规则式重排；local = 本地 CrossEncoder（需可选依赖）
RERANK_MODE=none

# ===== 服务 =====
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
DB_PATH=./data/knowledge_agent.db
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=10
